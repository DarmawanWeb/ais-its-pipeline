# ais-its-pipeline — every variable the two processes read (docs/PLATFORM_SPEC.md §4, §13.2).
# Copy to .env for local development: `pnpm dev:ingestor` and `pnpm dev:processor` both load
# it, so the per-process identity is NOT set here. Real secrets never go into the repository.

# --- Identity (per process; leave unset in a shared .env) ------------------------
# SERVICE_NAME defaults to ais-ingestor / ais-processor (event `source`, logs, metrics).
# SERVICE_NAME=
# PORT defaults to 3003 (ingestor) / 3004 (processor).
# PORT=
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0

# --- Both processes -------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000
# Comma separated list allowed. The ingestor produces to AIS_RAW, the processor to AIS_POSITION.
NATS_URL=nats://localhost:4222
# Prefix of durable consumer names (tests sharing one NATS server); empty in deployments.
NATS_DURABLE_PREFIX=
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection: ais:ingest (ingestor) and ais:read (processor) keys.
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for the introspection call — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
# Proxies whose X-Forwarded-For is trusted; empty = default (loopback,linklocal,uniquelocal).
TRUSTED_PROXIES=
# Tracing (OTLP/HTTP; disabled when unset).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Ingestor (stateless, no database) ------------------------------------------
# Upstream socket.io servers (legacy websocket.url / websocket.batam_url); empty = feed disabled.
AIS_PRIMARY_URL=
AIS_BATAM_URL=
# Handshake auth.token sent to both upstreams.
AIS_UPSTREAM_TOKEN=
# Reconnection backoff of the upstream clients: first delay, doubling up to the maximum (±50 % jitter) [ms].
AIS_UPSTREAM_RECONNECT_MIN_MS=1000
AIS_UPSTREAM_RECONNECT_MAX_MS=30000
# Token bucket of each socket.io pusher connection: sustained messages/s and burst size.
INGEST_SOCKET_RATE_PER_S=200
INGEST_SOCKET_BURST=2000
# Upstream reports awaiting their JetStream ack before new ones are dropped (backpressure).
INGEST_MAX_PENDING_PUBLISHES=10000

# --- Processor (schema "ais", Valkey) ---------------------------------------------
DATABASE_URL=postgres://ais_svc:ais_svc@localhost:5432/aisits
DATABASE_SCHEMA=ais
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true
# Valkey: last position per vessel (hash ais:last:<mmsi>).
REDIS_URL=redis://localhost:6379
# A newer report closer than this to the vessel's LATEST position is skipped [m].
AIS_DEDUP_MIN_DISTANCE_M=0.1
# Coast geometry (GeoJSON FeatureCollection) loaded once at startup; default data/coastline.geojson.
# GEO_COASTLINE_PATH=
# Batched writes of ais.positions + ais.vessel_latest: most rows per transaction, longest wait [ms].
PROCESSOR_BATCH_SIZE=500
PROCESSOR_FLUSH_MS=1000
# Vessels whose last position is cached in memory in front of Valkey.
AIS_STATE_CACHE_SIZE=100000
# Lifetime of ais:last:<mmsi> after the vessel's last recorded position [days].
AIS_STATE_TTL_DAYS=30
