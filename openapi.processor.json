{
  "openapi": "3.0.0",
  "paths": {
    "/api/v2/ais/latest": {
      "get": {
        "operationId": "PositionsController_latest",
        "parameters": [
          {
            "name": "bbox",
            "required": false,
            "in": "query",
            "description": "minLon,minLat,maxLon,maxLat (WGS 84 degrees)",
            "schema": {
              "example": "95,-11,141,6",
              "type": "string"
            }
          },
          {
            "name": "since",
            "required": false,
            "in": "query",
            "description": "Only vessels whose latest position is at or after this time (default: 24 h ago)",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50000,
              "default": 10000,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VesselLatestDto"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "summary": "Latest position of every vessel (map initial state)",
        "tags": [
          "ais"
        ],
        "x-api-key-scopes": [
          "ais:read"
        ],
        "x-required-permissions": [
          "ais:read"
        ]
      }
    },
    "/api/v2/ais/vessels/{mmsi}/latest": {
      "get": {
        "operationId": "PositionsController_vesselLatest",
        "parameters": [
          {
            "name": "mmsi",
            "required": true,
            "in": "path",
            "schema": {
              "minimum": 100000000,
              "maximum": 999999999,
              "example": 525005223,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VesselLatestDto"
                }
              }
            }
          },
          "404": {
            "description": "AIS_POSITION_NOT_FOUND"
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "summary": "Latest position of a vessel",
        "tags": [
          "ais"
        ],
        "x-api-key-scopes": [
          "ais:read"
        ],
        "x-required-permissions": [
          "ais:read"
        ]
      }
    },
    "/api/v2/ais/vessels/{mmsi}/track": {
      "get": {
        "operationId": "PositionsController_track",
        "parameters": [
          {
            "name": "mmsi",
            "required": true,
            "in": "path",
            "schema": {
              "minimum": 100000000,
              "maximum": 999999999,
              "example": 525005223,
              "type": "integer"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Start (ISO-8601); default: endpoint specific",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "End (ISO-8601); default: now",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "resolution",
            "required": false,
            "in": "query",
            "description": "raw ≤ 7 days, 1m ≤ 90 days",
            "schema": {
              "default": "raw",
              "type": "string",
              "enum": [
                "raw",
                "1m"
              ]
            }
          },
          {
            "name": "simplify",
            "required": false,
            "in": "query",
            "description": "Douglas–Peucker tolerance in metres (0 = none)",
            "schema": {
              "minimum": 0,
              "maximum": 100000,
              "example": 25,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackDto"
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "summary": "Track of a vessel (raw ≤ 7 days, 1m ≤ 90 days; default the last 24 h)",
        "tags": [
          "ais"
        ],
        "x-api-key-scopes": [
          "ais:read"
        ],
        "x-required-permissions": [
          "ais:read"
        ]
      }
    },
    "/api/v2/ais/pairs/track": {
      "get": {
        "operationId": "PositionsController_pairTrack",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Start (ISO-8601); default: endpoint specific",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "End (ISO-8601); default: now",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "mmsi1",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 100000000,
              "maximum": 999999999,
              "example": 525005223,
              "type": "integer"
            }
          },
          {
            "name": "mmsi2",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 100000000,
              "maximum": 999999999,
              "example": 525005224,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairTrackDto"
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "summary": "Raw tracks of two vessels over the same range (legacy /ais/routes/:mmsi1/:mmsi2)",
        "tags": [
          "ais"
        ],
        "x-api-key-scopes": [
          "ais:read"
        ],
        "x-required-permissions": [
          "ais:read"
        ]
      }
    },
    "/api/v2/ais/stats": {
      "get": {
        "operationId": "StatsController_describe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AisStatsDto"
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "summary": "Active vessels and recorded positions per minute, by feed",
        "tags": [
          "ais"
        ],
        "x-api-key-scopes": [
          "ais:read"
        ],
        "x-required-permissions": [
          "ais:read"
        ]
      }
    },
    "/api/v2/ais/methodology": {
      "get": {
        "operationId": "MethodologyController_describe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MethodologyDto"
                }
              }
            }
          },
          "default": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Methods implemented by this service, with their sources",
        "tags": [
          "methodology"
        ]
      }
    }
  },
  "info": {
    "title": "AIS Maritime Intelligence — AIS ITS Pipeline: processor",
    "description": "AIS processing and query API (spec §13.2): latest positions, tracks (raw / 1-minute), pair tracks and live statistics. AIS data is shared across tenants (`ais:read`; API keys with `ais:read`).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "ais",
      "description": "AIS positions, tracks and statistics"
    },
    {
      "name": "methodology",
      "description": "Methods of the methodology catalog implemented here"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token (EdDSA JWT)"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key sk_<id>_<secret>"
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token",
        "description": "Service-to-service token"
      }
    },
    "schemas": {
      "VesselRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "KM Sinar Bahari"
          },
          "typeCode": {
            "type": "string",
            "nullable": true,
            "example": "bulk_carrier"
          }
        },
        "required": [
          "id",
          "name",
          "typeCode"
        ]
      },
      "VesselLatestDto": {
        "type": "object",
        "properties": {
          "mmsi": {
            "type": "number",
            "example": 525005223
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "Position time"
          },
          "lat": {
            "type": "number",
            "example": -7.2
          },
          "lon": {
            "type": "number",
            "example": 112.73
          },
          "sog": {
            "type": "number",
            "description": "Speed over ground [kn]",
            "example": 8.5
          },
          "cog": {
            "type": "number",
            "description": "Course over ground [deg]",
            "example": 91
          },
          "hdg": {
            "type": "number",
            "description": "True heading [deg], 511 = not available",
            "example": 90
          },
          "navstatus": {
            "type": "number",
            "minimum": 0,
            "maximum": 15,
            "example": 0
          },
          "predictedNavstatus": {
            "type": "number",
            "enum": [
              0,
              1
            ],
            "description": "1 = predicted at anchor (navstatus.prediction)"
          },
          "source": {
            "type": "string",
            "enum": [
              "primary",
              "batam",
              "pusher"
            ]
          },
          "vessel": {
            "description": "Present when the fleet service knows the MMSI",
            "allOf": [
              {
                "$ref": "#/components/schemas/VesselRefDto"
              }
            ]
          }
        },
        "required": [
          "mmsi",
          "time",
          "lat",
          "lon",
          "sog",
          "cog",
          "hdg",
          "navstatus",
          "predictedNavstatus",
          "source"
        ]
      },
      "TrackPointDto": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "Position time (1m: start of the minute)"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "sog": {
            "type": "number",
            "description": "[kn] (1m: last of the minute)"
          },
          "cog": {
            "type": "number",
            "description": "[deg]"
          },
          "hdg": {
            "type": "number",
            "description": "[deg], 511 = not available"
          },
          "navstatus": {
            "type": "number"
          },
          "predictedNavstatus": {
            "type": "number",
            "enum": [
              0,
              1
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "primary",
              "batam",
              "pusher"
            ]
          },
          "samples": {
            "type": "number",
            "description": "1m only: reports in the minute"
          },
          "sogAvg": {
            "type": "number",
            "description": "1m only: mean SOG of the minute [kn]"
          },
          "sogMax": {
            "type": "number",
            "description": "1m only: maximum SOG of the minute [kn]"
          }
        },
        "required": [
          "time",
          "lat",
          "lon",
          "sog",
          "cog",
          "hdg",
          "navstatus",
          "predictedNavstatus",
          "source"
        ]
      },
      "TrackDto": {
        "type": "object",
        "properties": {
          "mmsi": {
            "type": "number",
            "example": 525005223
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "raw",
              "1m"
            ]
          },
          "simplifyM": {
            "type": "number",
            "nullable": true,
            "description": "Simplification tolerance [m], null = not simplified"
          },
          "truncated": {
            "type": "boolean",
            "description": "More than 100 000 points matched: narrow the range or use resolution 1m"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackPointDto"
            }
          }
        },
        "required": [
          "mmsi",
          "from",
          "to",
          "resolution",
          "simplifyM",
          "truncated",
          "points"
        ]
      },
      "PairTrackDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "tracks": {
            "description": "[mmsi1, mmsi2]",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackDto"
            }
          }
        },
        "required": [
          "from",
          "to",
          "tracks"
        ]
      },
      "FeedStatsDto": {
        "type": "object",
        "properties": {
          "activeVessels": {
            "type": "number",
            "description": "Vessels whose latest position came from this feed in the active window"
          },
          "messagesLastMinute": {
            "type": "number",
            "description": "Positions recorded from this feed in the last minute"
          }
        },
        "required": [
          "activeVessels",
          "messagesLastMinute"
        ]
      },
      "BySourceDto": {
        "type": "object",
        "properties": {
          "primary": {
            "$ref": "#/components/schemas/FeedStatsDto"
          },
          "batam": {
            "$ref": "#/components/schemas/FeedStatsDto"
          },
          "pusher": {
            "$ref": "#/components/schemas/FeedStatsDto"
          }
        },
        "required": [
          "primary",
          "batam",
          "pusher"
        ]
      },
      "AisStatsDto": {
        "type": "object",
        "properties": {
          "activeVessels": {
            "type": "number",
            "description": "Vessels with a position in the active window",
            "example": 1234
          },
          "messagesLastMinute": {
            "type": "number",
            "description": "Positions recorded in the last minute (by position time)",
            "example": 812
          },
          "bySource": {
            "$ref": "#/components/schemas/BySourceDto"
          },
          "activeWindowMinutes": {
            "type": "number",
            "example": 10
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "activeVessels",
          "messagesLastMinute",
          "bySource",
          "activeWindowMinutes",
          "at"
        ]
      },
      "LocalizedTextDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Bahasa Indonesia"
          },
          "en": {
            "type": "string",
            "description": "English"
          }
        },
        "required": [
          "id",
          "en"
        ]
      },
      "MethodReferenceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "imo-mepc-352-78"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title",
          "url"
        ]
      },
      "MethodSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cii.attained"
          },
          "catalogued": {
            "type": "boolean",
            "description": "Whether the catalog shipped with @darmawanweb/ais-its-contracts describes the method"
          },
          "domain": {
            "type": "string",
            "enum": [
              "ais",
              "emission",
              "seemp",
              "telemetry",
              "geo",
              "safety",
              "surveillance"
            ],
            "nullable": true
          },
          "name": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocalizedTextDto"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "implemented",
              "planned",
              "deprecated"
            ],
            "nullable": true
          },
          "needsCitation": {
            "type": "boolean",
            "description": "Values come from the thesis without a verified external source"
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MethodReferenceDto"
            }
          }
        },
        "required": [
          "id",
          "catalogued",
          "domain",
          "name",
          "status",
          "needsCitation",
          "references"
        ]
      },
      "MethodologyDto": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "example": "ais-processor"
          },
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MethodSummaryDto"
            }
          }
        },
        "required": [
          "service",
          "methods"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Problem type URI"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "description": "Request path",
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$",
            "description": "Stable UPPER_SNAKE_CASE error code"
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Dot separated path, e.g. \"positions.0.lat\""
                },
                "message": {
                  "type": "string"
                },
                "code": {
                  "description": "Machine readable reason",
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "additionalProperties": false,
              "description": "Field-level validation error"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": {},
        "description": "RFC 9457 problem details"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
